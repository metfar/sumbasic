{
  "schema_version": 1,
  "title": "sumBASIC Help",
  "intro": "The BASIC reference is example-driven. Select a topic and copy or run its functional example.",
  "topics": [
    {
      "name": "PRINT",
      "category": "Console I/O",
      "summary": "Writes values to the current output stream.",
      "syntax": [
        "PRINT expression",
        "PRINT expression;",
        "? expression"
      ],
      "example": "name$ = \"Ada\"\nPRINT \"Hello \"; name$\n? 2 + 2",
      "notes": [
        "A trailing semicolon suppresses the normal newline where supported.",
        "? is the short PRINT form."
      ],
      "see_also": [
        "INPUT",
        "LOCATE"
      ],
      "aliases": [
        "?"
      ],
      "language": "basic"
    },
    {
      "name": "INPUT",
      "category": "Console I/O",
      "summary": "Reads a value from the user into a variable.",
      "syntax": [
        "INPUT variable",
        "INPUT \"Prompt\"; variable",
        "INPUT \"Prompt\", variable"
      ],
      "example": "INPUT \"Name\"; name$\nPRINT \"Hello \"; name$",
      "notes": [
        "With a semicolon after the prompt",
        "sumBASIC displays the traditional \"? \" prompt marker.",
        "With a comma after the prompt",
        "input follows the prompt directly."
      ],
      "see_also": [
        "PRINT",
        "INKEY$"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "IF",
      "category": "Programming",
      "summary": "Executes code conditionally.",
      "syntax": [
        "IF condition THEN statement",
        "IF condition THEN",
        "    statements",
        "ELSE",
        "    statements",
        "END IF"
      ],
      "example": "age = 20\nIF age >= 18 THEN\n    PRINT \"adult\"\nELSE\n    PRINT \"minor\"\nEND IF",
      "notes": [],
      "see_also": [
        "FOR",
        "WHILE",
        "DO"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "FOR",
      "category": "Programming",
      "summary": "Repeats a block while a numeric control variable advances toward a limit.",
      "syntax": [
        "FOR variable = first TO last [STEP step]",
        "NEXT [variable]"
      ],
      "example": "FOR i = 1 TO 5\n    PRINT i\nNEXT i",
      "notes": [],
      "see_also": [
        "WHILE",
        "DO"
      ],
      "aliases": [
        "NEXT"
      ],
      "language": "basic"
    },
    {
      "name": "WHILE",
      "category": "Programming",
      "summary": "Repeats a block while its condition remains true.",
      "syntax": [
        "WHILE condition",
        "WEND"
      ],
      "example": "i = 1\nWHILE i <= 3\n    PRINT i\n    i = i + 1\nWEND",
      "notes": [],
      "see_also": [
        "FOR",
        "DO"
      ],
      "aliases": [
        "WEND"
      ],
      "language": "basic"
    },
    {
      "name": "DO",
      "category": "Programming",
      "summary": "Provides DO/LOOP structured repetition, optionally controlled by WHILE or UNTIL.",
      "syntax": [
        "DO",
        "LOOP",
        "DO WHILE condition",
        "LOOP UNTIL condition"
      ],
      "example": "i = 0\nDO\n    i = i + 1\n    PRINT i\nLOOP UNTIL i >= 3",
      "notes": [],
      "see_also": [
        "WHILE",
        "FOR"
      ],
      "aliases": [
        "LOOP"
      ],
      "language": "basic"
    },
    {
      "name": "DATA",
      "category": "Programming",
      "summary": "Stores literal data in the program for sequential READ operations.",
      "syntax": [
        "DATA value [, value ...]",
        "READ variable [, variable ...]",
        "RESTORE [line-or-label]"
      ],
      "example": "DATA \"red\", \"green\", \"blue\"\nREAD a$, b$\nPRINT a$; \" \"; b$\nRESTORE\nREAD c$\nPRINT c$",
      "notes": [
        "RESTORE without an argument rewinds the DATA pointer.",
        "Named labels may identify DATA blocks."
      ],
      "see_also": [
        "READ",
        "RESTORE"
      ],
      "aliases": [
        "READ",
        "RESTORE"
      ],
      "language": "basic"
    },
    {
      "name": "DIM",
      "category": "Data",
      "summary": "Creates arrays using BASIC dimensions.",
      "syntax": [
        "DIM name(size)",
        "DIM name(rows, columns)"
      ],
      "example": "DIM table(2, 2)\ntable(1, 1) = 42\nPRINT table(1, 1)",
      "notes": [],
      "see_also": [
        "LBOUND",
        "UBOUND",
        "REDIM"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "BEEP",
      "category": "Audio",
      "summary": "Plays a ZX Spectrum-style note using duration then semitone pitch offset from middle C.",
      "syntax": [
        "BEEP duration, pitch"
      ],
      "example": "BEEP .15, 0\nBEEP .15, 4\nBEEP .15, 7\nBEEP .3, 12",
      "notes": [
        "0 is middle C; +12 is one octave above and -12 one octave below.",
        "BEEP is intentionally blocking."
      ],
      "see_also": [
        "SOUND",
        "PLAY"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "SOUND",
      "category": "Audio",
      "summary": "Plays a GW-BASIC-style tone using frequency and duration.",
      "syntax": [
        "SOUND frequency, duration"
      ],
      "example": "SOUND 440, .25\nSOUND 660, .25",
      "notes": [
        "SOUND and BEEP intentionally keep different historical argument semantics."
      ],
      "see_also": [
        "BEEP",
        "PLAY"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "PLAY",
      "category": "Audio",
      "summary": "Plays music using the BASIC music-string facilities.",
      "syntax": [
        "PLAY string-expression",
        "ZXPLAY string-expression",
        "GWPLAY string-expression"
      ],
      "example": "PLAY \"C D E F G\"",
      "notes": [],
      "see_also": [
        "BEEP",
        "SOUND"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "SHELL",
      "category": "Environment",
      "summary": "Runs a host shell command or opens an interactive shell when used without a command.",
      "syntax": [
        "SHELL",
        "SHELL string-expression"
      ],
      "example": "SHELL \"printf 'hello from the shell\\n'\"",
      "notes": [
        "The configured host shell is used; sumBASIC does not implement a second shell parser."
      ],
      "see_also": [
        "SYSTEM"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "STOP",
      "category": "Programming",
      "summary": "Suspends a running BASIC program while preserving state for CONTINUE.",
      "syntax": [
        "STOP",
        "CONTINUE",
        "CONT"
      ],
      "example": "PRINT \"before\"\nSTOP\nPRINT \"after\"",
      "notes": [
        "STOP is resumable; END and a user-requested IDE stop are not.",
        "In the IDE",
        "F5 resumes when the previous run stopped at STOP."
      ],
      "see_also": [
        "CONTINUE",
        "END"
      ],
      "aliases": [
        "CONT",
        "CONTINUE"
      ],
      "language": "basic"
    },
    {
      "name": "INKEY$",
      "category": "Console I/O",
      "summary": "Returns a pending key immediately, or an empty string when no key is waiting.",
      "syntax": [
        "INKEY$"
      ],
      "example": "PRINT \"Press Q to quit\"\nDO\n    k$ = INKEY$\nLOOP UNTIL UCASE$(k$) = \"Q\"",
      "notes": [
        "Interactive --run mode places POSIX terminals in cbreak mode so INKEY$ does not wait for Enter."
      ],
      "see_also": [
        "INPUT"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "OPEN",
      "category": "Files",
      "summary": "Opens BASIC file/channel I/O resources.",
      "syntax": [
        "OPEN ...",
        "OPEN # ...",
        "CLOSE #channel",
        "FREEFILE"
      ],
      "example": "OPEN \"example.txt\" FOR OUTPUT AS #1\nWRITE #1, \"hello\"\nCLOSE #1",
      "notes": [],
      "see_also": [
        "GET",
        "PUT",
        "WRITE",
        "EOF",
        "LOF",
        "LOC"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "MATH",
      "category": "Functions",
      "summary": "sumBASIC includes classic BASIC/Spectrum functions plus an extended mathematical vocabulary.",
      "syntax": [
        "SIN(x)  COS(x)  TAN(x)",
        "SQR(x)  SQRT(x)  ABS(x)",
        "LOG(x)  LOG10(x)  LOG2(x)",
        "GCD(a,b)  LCM(a,b)  FACT(n)"
      ],
      "example": "PRINT SIN(PI / 2)\nPRINT SQRT(81)\nPRINT GCD(84, 30)",
      "notes": [
        "PI follows the Spectrum-inspired BASIC vocabulary."
      ],
      "see_also": [],
      "aliases": [
        "SQR",
        "SQRT"
      ],
      "language": "basic"
    },
    {
      "name": "PAUSE",
      "category": "Functions",
      "summary": "Waits for a number of seconds or until the user provides input. `PAUSE 0` waits indefinitely. In graphical mode, keyboard, mouse and touch presses interrupt the wait while the window continues to process redraw and resize events.",
      "syntax": [
        "PAUSE seconds"
      ],
      "example": "PRINT \"Press a key/click/touch, or wait one second\"\nPAUSE 1\nPRINT \"Continuing\"",
      "notes": [],
      "see_also": [
        "INKEY$",
        "DISPLAY"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "COLOR",
      "category": "Graphics and images",
      "summary": "Sets the BASIC foreground, background and optional border colors. Numeric colors 0-15 use the GW-BASIC/QBASIC-compatible 16-color palette on arbitrary BASIC graphics modes.",
      "syntax": [
        "COLOR foreground [, background [, border]]"
      ],
      "example": "SCREEN 640,480\nCOLOR 14,0,1\nLINE (0,0)-(639,479)",
      "notes": [],
      "see_also": [
        "INK",
        "PAPER",
        "BORDER"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "PAINT",
      "category": "Graphics and images",
      "summary": "Flood-fills an enclosed area. `FILL` is an alias.",
      "syntax": [
        "PAINT (x,y) [, color [, border]]",
        "FILL (x,y) [, color [, border]]"
      ],
      "example": "SCREEN 320,240\nCOLOR 15,0\nRECTANGLE 20,20,100,80,14\nPAINT (30,30),1,14",
      "notes": [],
      "see_also": [
        "COLOR",
        "RECTANGLE"
      ],
      "aliases": [
        "FILL"
      ],
      "language": "basic"
    },
    {
      "name": "GET",
      "category": "Graphics and images",
      "summary": "Captures a graphical region as a portable image value.",
      "syntax": [
        "image = GET(x,y,width,height)",
        "GET (x1,y1)-(x2,y2)"
      ],
      "example": "Tile = GET(10,10,64,64)\nPUT (100,100), Tile\nPUT (50,50), GET(150,150,10,10)",
      "notes": [],
      "see_also": [
        "PUT",
        "BSAVE",
        "BLOAD"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "PUT",
      "category": "Graphics and images",
      "summary": "Draws an image value or a direct `GET(...)` capture at a destination coordinate.",
      "syntax": [
        "PUT (x,y), image",
        "PUT (x,y), GET(source_x,source_y,width,height)"
      ],
      "example": "SCREEN 320,240\nPUT (50,50), GET(150,150,10,10)",
      "notes": [],
      "see_also": [
        "GET",
        "BSAVE",
        "BLOAD"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "BSAVE",
      "category": "Graphics and images",
      "summary": "Preserves classic memory-range binary saving and also saves portable graphical images. The image format is inferred from the filename extension; PNG is the preferred format.",
      "syntax": [
        "BSAVE filename, address, length",
        "BSAVE filename, SCREEN",
        "BSAVE filename, image",
        "BSAVE filename, GET(x,y,width,height)",
        "BSAVE filename, GET (x1,y1)-(x2,y2)"
      ],
      "example": "SCREEN 640,480\nLINE (0,0)-(639,479),14\nBSAVE \"screen.png\", SCREEN\nBSAVE \"part.png\", GET(0,0,100,100)",
      "notes": [],
      "see_also": [
        "BLOAD",
        "GET",
        "PUT"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "BLOAD",
      "category": "Graphics and images",
      "summary": "Preserves classic binary loading and can load an image into a variable or directly onto the graphics screen.",
      "syntax": [
        "BLOAD filename, address",
        "BLOAD filename, image_variable",
        "BLOAD filename, SCREEN [, x, y]"
      ],
      "example": "BLOAD \"sprite.png\", sprite\nPUT (100,80), sprite",
      "notes": [],
      "see_also": [
        "BSAVE",
        "GET",
        "PUT"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "CHART",
      "category": "Graphics and images",
      "summary": "Draws a chart into the current graphics surface using the backend-neutral Sum chart model. Supported kinds are BAR, HBAR, LINE, SCATTER, PIE and RADAR.",
      "syntax": [
        "CHART kind,x,y,width,height,categories,values [,title [,series_name]]",
        "CHART kind TITLE title X categories Y values [AT x,y] [SIZE width,height] [FONT SIZE n] [TITLE FONT SIZE n] [RENDERER native|matplotlib|seaborn]"
      ],
      "example": "DISPLAY 640,480,65536,AUTO\nCHART BAR \\\n    TITLE \"Users by OS\" \\\n    X \"Android\",\"Linux\",\"Windows\" \\\n    Y 500,800,600 \\\n    FONT SIZE 10 \\\n    RENDERER \"native\"\nPAUSE 0",
      "notes": [],
      "see_also": [
        "TABLE",
        "BSAVE"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "TABLE",
      "category": "Graphics and images",
      "summary": "Draws a formatted table with optional title into the current graphics surface.",
      "syntax": [
        "TABLE x,y,width,height,headers,rows [,title]"
      ],
      "example": "SCREEN 640,480\nTABLE 20,20,300,160,[\"OS\",\"Users\"],[[\"Android\",500],[\"Linux\",800]],\"Usage\"",
      "notes": [],
      "see_also": [
        "CHART",
        "BSAVE"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "DISPLAY",
      "category": "Graphics and images",
      "summary": "Creates a modern arbitrary-resolution graphics display. Unlike historical `SCREEN` modes, `DISPLAY` is not limited to legacy resolutions or palette sizes. `AUTO` presents each drawing command immediately; `MANUAL` keeps drawing off-screen until `DISPLAY UPDATE`.",
      "syntax": [
        "DISPLAY width,height,colors_or_bits,AUTO|MANUAL [,pages [,active_page [,visible_page]]]",
        "DISPLAY ACTIVE page",
        "DISPLAY VISIBLE page",
        "DISPLAY UPDATE"
      ],
      "example": "DISPLAY 640,480,65536,MANUAL,2,1,0\nLINE (0,0)-(639,479),11\nDISPLAY VISIBLE 1\nDISPLAY UPDATE",
      "notes": [],
      "see_also": [
        "SCREEN",
        "COPY",
        "FONT"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "SCREEN",
      "category": "Graphics and images",
      "summary": "Selects a historical BASIC graphics profile or text mode. `SCREEN 12` is 640x480 with 16 colors and `SCREEN 13` is 320x200 with 256 colors. Active and visible pages are preserved as separate concepts.",
      "syntax": [
        "SCREEN 0",
        "SCREEN 12 [,colorswitch [,active_page [,visible_page]]]",
        "SCREEN 13 [,colorswitch [,active_page [,visible_page]]]",
        "SCREEN \"SPECTRUM\""
      ],
      "example": "SCREEN 12,,1,0\nLINE (10,10)-(200,100),11",
      "notes": [],
      "see_also": [
        "DISPLAY",
        "COPY"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "COPY SCREEN",
      "category": "Graphics and images",
      "summary": "Copies a complete graphics page to another page.",
      "syntax": [
        "COPY SCREEN FROM source_page TO destination_page",
        "COPY SCREEN source_page TO destination_page"
      ],
      "example": "DISPLAY 320,240,256,MANUAL,2,1,0\nLINE (0,0)-(319,239),11\nCOPY SCREEN FROM 1 TO 0\nDISPLAY VISIBLE 0\nDISPLAY UPDATE",
      "notes": [],
      "see_also": [
        "DISPLAY",
        "SCREEN"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "FONT",
      "category": "Graphics and images",
      "summary": "Sets the default graphical font. Charts, tables and text inherit it unless they provide a more specific font size/family.",
      "syntax": [
        "FONT family,size [,bold [,italic [,underline]]]"
      ],
      "example": "DISPLAY 640,480,65536,AUTO\nFONT \"monospace\",12\nOUTTEXTXY 20,20,\"Sum\",15",
      "notes": [],
      "see_also": [
        "OUTTEXTXY",
        "CHART",
        "TABLE"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "ARC",
      "category": "Graphics and images",
      "summary": "Draws a circular arc using BGI-style start/end angles in degrees.",
      "syntax": [
        "ARC x,y,start_angle,end_angle,radius [,color]"
      ],
      "example": "DISPLAY 320,240,256,AUTO\nARC 160,120,220,320,60,15",
      "notes": [],
      "see_also": [
        "CIRCLE",
        "ELLIPSE"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "ELLIPSE",
      "category": "Graphics and images",
      "summary": "Draws an ellipse or elliptical arc.",
      "syntax": [
        "ELLIPSE x,y,start_angle,end_angle,rx,ry [,color]"
      ],
      "example": "DISPLAY 320,240,256,AUTO\nELLIPSE 160,120,0,360,80,40,11",
      "notes": [],
      "see_also": [
        "ARC",
        "CIRCLE"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "OUTTEXTXY",
      "category": "Graphics and images",
      "summary": "Draws text at pixel coordinates on the graphics surface.",
      "syntax": [
        "OUTTEXTXY x,y,text [,color [,size [,font_family]]]"
      ],
      "example": "DISPLAY 640,480,65536,AUTO\nOUTTEXTXY 20,20,\"Hello from sumBASIC\",15,14,\"monospace\"",
      "notes": [],
      "see_also": [
        "FONT"
      ],
      "aliases": [],
      "language": "basic"
    },
    {
      "name": "GOTOXY",
      "category": "Graphics and images",
      "summary": "Moves the text cursor using the classic `conio.h` order `X,Y`. Coordinates are one-based. `LOCATE Y,X` reaches the same logical cell. Spectrum-compatible `PRINT AT Y,X; ...` keeps the historical zero-based AT coordinates.",
      "syntax": [
        "GOTOXY x,y",
        "LOCATE y,x",
        "PRINT AT y,x; expression"
      ],
      "example": "GOTOXY 10,5\nPRINT \"GOTOXY\"\nLOCATE 7,10\nPRINT \"LOCATE\"\nPRINT AT 8,9; \"PRINT AT\"",
      "notes": [],
      "see_also": [
        "LOCATE",
        "PRINT"
      ],
      "aliases": [],
      "language": "basic"
    }
  ]
}
