# r20.2 demo: 8x8 one-bit BORDER tile, foreground/background and scrolling.
DISPLAY (256, 192, 16, AUTO)
PAPER 0
BORDER 1
DEF PATTERN 1, 0b11110000, 0b11110000, 0b00001111, 0b00001111, 0b11110000, 0b11110000, 0b00001111, 0b00001111
BORDER INK 6
BORDER PAPER 1
BORDER PATTERN 1
GPRINT 32, 80, "Q exits", 15, 18
CURSOR OFF
:LOOP
BORDER SCROLL 1, 1
PAUSE .05
K$ = INKEY$
IF K$ = "Q" OR K$ = "q" OR K$ = CHR$(27) THEN END
GOTO LOOP
