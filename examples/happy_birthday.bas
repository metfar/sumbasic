# Happy Birthday / Feliz cumpleaños using Spectrum-128 PLAY.
# PLAY is ZXPLAY; each phrase is foreground, so they play in sequence.

PRINT "Happy Birthday - ZXPLAY"

Part1$ = "T120O5N3gg5agC7b"
Part2$ = "T120O5N3gg5agD7C"
Part3$ = "T120O5N3gg5GECb7a"
# Final phrase: F F E C D C. The last C is a half note.
Part4$ = "T120O5N3FF5ECD7C"

PLAY Part1$
PLAY Part2$
PLAY Part3$
PLAY Part4$

PRINT "Happy birthday!"
END
